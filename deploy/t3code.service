[Unit]
Description=T3 Code server (local fork, loopback only; Caddy exposes it on the tailnet)
After=network-online.target

[Service]
WorkingDirectory=%h/code
Environment=PATH=%h/.local/opt/node-v26.12.1-linux-x64/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# No product analytics, relay tracing or OpenTelemetry export; ingest host blackholed as a backstop.
Environment=T3CODE_TELEMETRY_ENABLED=false
Environment=T3CODE_POSTHOG_HOST=http://127.0.0.1:9
Environment=T3CODE_OTEL_SDK_DISABLED=true
Environment=OTEL_SDK_DISABLED=true
Environment=T3CODE_NO_BROWSER=1
ExecStart=%h/.local/opt/node-v26.12.1-linux-x64/bin/node %h/code/t3code/apps/server/dist/bin.mjs serve --mode web --host 127.0.0.1 --port 3773 --no-browser %h/code
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
